[Unit]
Description=Clawd Companion ranked arena API
After=network.target

[Service]
Type=simple
DynamicUser=yes
User=clawd-arena
WorkingDirectory=/opt/clawd-companion
StateDirectory=clawd-arena
StateDirectoryMode=0700
Environment=CLAWD_DATABASE=/var/lib/clawd-arena/arena.sqlite3
Environment=CLAWD_TRUST_PROXY=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/clawd-arena.env
ExecStart=/usr/bin/gunicorn --preload --bind 127.0.0.1:9184 --workers 2 --threads 4 --timeout 30 Server.wsgi:application
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
