# Include in the existing HTTPS server block for zumbyte.de.
location ^~ /api/clawd/v1/ {
    client_max_body_size 4k;
    client_body_timeout 8s;
    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
    proxy_pass http://127.0.0.1:9184;
    proxy_set_header Host zumbyte.de;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header Authorization $http_authorization;
    # The route contains opaque run IDs. The service emits its own failure logs.
    access_log off;
}
