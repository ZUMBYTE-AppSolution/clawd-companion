Name: clawd-companion
Version: @VERSION@
Release: 1
Summary: Animated pixel companion for Claude
License: LicenseRef-Clawd-Companion
URL: https://github.com/ZUMBYTE-AppSolution/clawd-companion
Source0: payload.tar.gz
BuildArch: x86_64
AutoReqProv: no
Requires: nss, alsa-lib, libXcomposite, libXdamage, libXrandr, libXtst, libdrm, mesa-libgbm
Requires: glibc >= 2.35
Requires: pulseaudio-libs, speech-dispatcher-libs
Requires: libglvnd-glx, libglvnd-egl, fontconfig, libxkbcommon-x11, xcb-util-cursor, xcb-util-wm, xcb-util-image, xcb-util-keysyms, xcb-util-renderutil, libxcb, libX11-xcb, dbus-libs
%global debug_package %{nil}
%global __os_install_post %{nil}

%description
A desktop companion with an animated overlay and idle arcade.

%install
mkdir -p "%{buildroot}"
tar -xf "%{SOURCE0}" -C "%{buildroot}"

%files
%defattr(-,root,root,-)
/opt/clawd-companion
/usr/bin/clawd-companion
/usr/share/applications/clawd-companion.desktop
/usr/share/icons/hicolor/128x128/apps/clawd-companion.png
